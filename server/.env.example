# ── Server ────────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8001
DEBUG=false

# ── CORS ──────────────────────────────────────────────────────────────────────
# Replace with your actual front-end origin(s)
ALLOWED_ORIGINS=[*]

# ── Storage ───────────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
OUTPUT_DIR=outputs
MAX_UPLOAD_SIZE_MB=500

# ── HU window presets ─────────────────────────────────────────────────────────
HU_BONE_MIN=200
HU_BONE_MAX=1500
HU_SOFT_TISSUE_MIN=-100
HU_SOFT_TISSUE_MAX=300
HU_LUNG_MIN=-1000
HU_LUNG_MAX=-500

# ── 3-D reconstruction ────────────────────────────────────────────────────────
DEFAULT_ISO_VALUE=300.0
SMOOTHING_ITERATIONS=15
SMOOTHING_RELAXATION=0.1
DECIMATION_REDUCTION=0.5

# ── AI model ──────────────────────────────────────────────────────────────────
# Leave blank if you don't have a weights file yet.
# The service will still work using HU threshold segmentation.
MODEL_WEIGHTS_PATH=
SEGMENTATION_THRESHOLD=0.5
INFERENCE_BATCH_SIZE=2

# ── Concurrency ───────────────────────────────────────────────────────────────
MAX_CONCURRENT_JOBS=3
